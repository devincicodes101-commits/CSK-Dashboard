# Copy to .env.local and fill in. Never commit the filled-in version.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the sync job and the migration script.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, for scripts/migrate.mjs only.
SUPABASE_DB_URL=

# --- Jobber ---------------------------------------------------------------
# From developer.getjobber.com -> Manage Apps -> CSK Dashboard
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Must match the callback URL registered on the Jobber app, character for
# character, including the absence of a trailing slash.
JOBBER_REDIRECT_URI=http://localhost:3005/api/jobber/callback

# --- QuickBooks Online ----------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3005/api/quickbooks/callback
# "sandbox" while testing, "production" against CSK's real company file.
QBO_ENVIRONMENT=sandbox

# --- Access ---------------------------------------------------------------
# REQUIRED. A shared passphrase; without it the dashboard refuses to serve
# anything rather than falling open. Make it long — it is the only thing
# between the public internet and CSK's revenue and bank balance.
DASHBOARD_PASSWORD=

# For the eventual move to per-person accounts. Nothing reads this yet.
ALLOWED_EMAILS=

# Shared secret the Vercel cron job sends, so the sync route cannot be
# triggered by anyone who finds the URL.
CRON_SECRET=
